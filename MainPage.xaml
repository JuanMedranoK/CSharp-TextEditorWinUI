<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CSharp_TextEditorWinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CSharp_TextEditorWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        This is the main content area of your application.
        Add your UI elements here — for example, controls, layouts, and data-bound views.
        Use 'dotnet new winui-page' to create additional pages and navigate to them via
        the Frame in MainWindow (RootFrame).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Archivo">

                <MenuFlyoutItem
                Text="Nuevo"
                Click="Nuevo_Click" />

                <MenuFlyoutItem
                Text="Abrir"
                Click="Abrir_Click" />

                <MenuFlyoutItem
                Text="Guardar"
                Click="Guardar_Click" />

                <MenuFlyoutItem
                Text="Guardar como"
                Click="GuardarComo_Click" />

                <MenuFlyoutSeparator />

                <MenuFlyoutItem
                Text="Salir"
                Click="Salir_Click" />

            </MenuBarItem>
        </MenuBar>

        <TextBox
           x:Name="EditorTextBox"
           Grid.Row="1"
           AcceptsReturn="True"
           TextWrapping="Wrap"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           HorizontalContentAlignment="Stretch"
           VerticalContentAlignment="Stretch"
           BorderThickness="0" />
    </Grid>
</Page>
